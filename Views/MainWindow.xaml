<Window x:Class="SFRThelper.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SFRT Lattice Helper  —  ESAPI 16.1"
        Width="1360" Height="900"
        MinWidth="1100" MinHeight="740">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                    <Setter Property="BorderBrush" Value="Firebrick"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Spatially Fractionated RT  /  Lattice Generator"
                       FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Right"
                       Text="AAPM TG-263 Peak_xx  ·  Lattice_Peaks  ·  Lattice_Valley"
                       VerticalAlignment="Center" Foreground="Gray" Margin="12,0,0,0"/>
        </DockPanel>

        <TabControl Grid.Row="1">
            <!-- Geometry / generation -->
            <TabItem Header="Geometry &amp; Lattice">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="430"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <GroupBox Header="Geometry configuration" Margin="0,0,0,8">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="168"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Target (GTV/PTV):" VerticalAlignment="Center" Margin="4"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1"
                                              ItemsSource="{Binding AvailableTargets}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding Parameters.SelectedTargetId}"
                                              IsEnabled="{Binding IsIdle}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="OAR Avoidance 1:" VerticalAlignment="Center" Margin="4"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1"
                                              ItemsSource="{Binding AvailableOARs}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding Parameters.Oar1StructureId}"
                                              IsEnabled="{Binding IsIdle}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="OAR 1 clearance (mm):" VerticalAlignment="Center" Margin="4"/>
                                    <TextBox Grid.Row="2" Grid.Column="1"
                                             Text="{Binding Parameters.Oar1ClearanceMm, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                             IsEnabled="{Binding IsIdle}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="OAR Avoidance 2:" VerticalAlignment="Center" Margin="4"/>
                                    <ComboBox Grid.Row="3" Grid.Column="1"
                                              ItemsSource="{Binding AvailableOARs}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding Parameters.Oar2StructureId}"
                                              IsEnabled="{Binding IsIdle}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="OAR 2 clearance (mm):" VerticalAlignment="Center" Margin="4"/>
                                    <TextBox Grid.Row="4" Grid.Column="1"
                                             Text="{Binding Parameters.Oar2ClearanceMm, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                             IsEnabled="{Binding IsIdle}"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Target clearance (mm):" VerticalAlignment="Center" Margin="4"/>
                                    <TextBox Grid.Row="5" Grid.Column="1"
                                             Text="{Binding Parameters.TargetClearanceMm, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                             IsEnabled="{Binding IsIdle}"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Sphere diameter (mm):" VerticalAlignment="Center" Margin="4"/>
                                    <TextBox Grid.Row="6" Grid.Column="1"
                                             Text="{Binding Parameters.SphereDiameterMm, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                             IsEnabled="{Binding IsIdle}"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Center-to-center (mm):" VerticalAlignment="Center" Margin="4"/>
                                    <TextBox Grid.Row="7" Grid.Column="1"
                                             Text="{Binding Parameters.CenterSpacingMm, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                             IsEnabled="{Binding IsIdle}"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Packing topology:" VerticalAlignment="Center" Margin="4"/>
                                    <ComboBox Grid.Row="8" Grid.Column="1"
                                              ItemsSource="{Binding PackingOptions}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding Parameters.PackingMode}"
                                              IsEnabled="{Binding IsIdle}"/>

                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Sphere structures:" VerticalAlignment="Center" Margin="4"/>
                                    <ComboBox Grid.Row="9" Grid.Column="1"
                                              ItemsSource="{Binding GenerationModeOptions}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding Parameters.GenerationMode}"
                                              IsEnabled="{Binding IsIdle}"/>

                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Max sphere count:" VerticalAlignment="Center" Margin="4"/>
                                    <TextBox Grid.Row="10" Grid.Column="1"
                                             Text="{Binding Parameters.MaxSphereCount, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                             IsEnabled="{Binding IsIdle}"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Pre-calculation feasibility" Margin="0,0,0,8">
                                <TextBox Text="{Binding FeasibilityText, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         MinHeight="150"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Margin="4"/>
                            </GroupBox>

                            <WrapPanel>
                                <Button Content="Preview Lattice"
                                        Command="{Binding PreviewLatticeCommand}"
                                        IsEnabled="{Binding CanPreview}"/>
                                <Button Content="Regenerate Remaining"
                                        Command="{Binding RegenerateRemainingCommand}"
                                        IsEnabled="{Binding CanRegenerateRemaining}"/>
                                <Button Content="Generate Structures"
                                        Command="{Binding GenerateStructuresCommand}"
                                        IsEnabled="{Binding CanCreateStructures}"/>
                                <Button Content="Cancel"
                                        Command="{Binding CancelCommand}"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                            </WrapPanel>

                            <GroupBox Header="Generated peak centers" Margin="0,8,0,0" Height="220">
                                <DataGrid ItemsSource="{Binding GeneratedSpheres}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                                        <DataGridTextColumn Header="X" Binding="{Binding X, StringFormat=F1}" Width="60"/>
                                        <DataGridTextColumn Header="Y" Binding="{Binding Y, StringFormat=F1}" Width="60"/>
                                        <DataGridTextColumn Header="Z" Binding="{Binding Z, StringFormat=F1}" Width="60"/>
                                        <DataGridTextColumn Header="R" Binding="{Binding Radius, StringFormat=F1}" Width="50"/>
                                        <DataGridCheckBoxColumn Header="Edited" Binding="{Binding IsEdited}" Width="60"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Slice −" Width="80" Command="{Binding SliceDownCommand}"/>
                            <TextBlock Text="{Binding CurrentSliceText}" VerticalAlignment="Center"
                                       FontWeight="Bold" Margin="10,0"/>
                            <Button Content="Slice +" Width="80" Command="{Binding SliceUpCommand}"/>
                            <TextBlock Text="Drag a peak on the axial view. Invalid moves (outside V_valid or too close) are blocked."
                                       Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                        <GroupBox Grid.Row="1" Header="Axial 2D viewer">
                            <Grid Background="#111">
                                <Canvas Name="AxialCanvas" Background="Black"/>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Plan evaluation -->
            <TabItem Header="Plan Evaluation">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="220"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Plan / PlanSum:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailablePlans}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedPlan}"
                                  IsEnabled="{Binding IsIdle}"/>
                        <Button Grid.Column="2" Content="Refresh Plans"
                                Command="{Binding RefreshPlansCommand}"/>
                        <Button Grid.Column="3" Content="Evaluate Plan"
                                Command="{Binding EvaluatePlanCommand}"
                                IsEnabled="{Binding CanEvaluate}"/>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,0,0,8" Padding="8" CornerRadius="3"
                            BorderThickness="1"
                            Background="#FFF8E7" BorderBrush="#C9A227">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="Status:" FontWeight="Bold" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding EvaluationAlertText}" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <GroupBox Grid.Row="2" Header="Peak / valley / PVDR metrics" Margin="0,0,0,8">
                        <DataGrid ItemsSource="{Binding EvaluationMetrics}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90"/>
                                <DataGridTextColumn Header="Structure" Binding="{Binding Structure}" Width="160"/>
                                <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="120"/>
                                <DataGridTextColumn Header="Absolute" Binding="{Binding Absolute}" Width="110"/>
                                <DataGridTextColumn Header="Relative / flag" Binding="{Binding Relative}" Width="130"/>
                                <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Grid.Row="3" Header="Individual Peak_xx consistency">
                        <DataGrid ItemsSource="{Binding IndividualPeakDoses}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="100"/>
                                <DataGridTextColumn Header="Volume (cc)" Binding="{Binding VolumeCc, StringFormat=F2}" Width="110"/>
                                <DataGridTextColumn Header="Dmax (Gy)" Binding="{Binding DmaxGy, StringFormat=F2}" Width="110"/>
                                <DataGridTextColumn Header="Dmean (Gy)" Binding="{Binding DmeanGy, StringFormat=F2}" Width="110"/>
                                <DataGridTextColumn Header="Dmin (Gy)" Binding="{Binding DminGy, StringFormat=F2}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
