<Window x:Class="SFRThelper.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SFRThelper.Converters"
        Title="nSFRT Lattice / SFRT Suite  —  Eclipse 16.1"
        Width="1440" Height="940"
        MinWidth="1180" MinHeight="760">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanConverter x:Key="InverseBool"/>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                    <Setter Property="BorderBrush" Value="Firebrick"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#9AA4B2"/>
            <Setter Property="Background" Value="#F4F7FB"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Clinical Lattice / SFRT Planning Suite"
                       FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Protocol:" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <ComboBox Width="320"
                          ItemsSource="{Binding ProtocolOptions}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding SelectedPreset}"
                          IsEnabled="{Binding IsIdle}"
                          ToolTip="{Binding PresetDescription}"/>
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1">
            <!-- Tab 1: Geometry -->
            <TabItem Header="Geometry &amp; Optimization">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="460"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding PresetDescription}" TextWrapping="Wrap"
                                       Foreground="#445" Margin="4,0,4,8" FontStyle="Italic"/>

                            <GroupBox Header="Target, OARs, and skin avoidance" Margin="0,0,0,8">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="176"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Target (GTV/PTV):" VerticalAlignment="Center" Margin="4"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1"
                                              ItemsSource="{Binding AvailableTargets}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding Parameters.SelectedTargetId}"
                                              IsEnabled="{Binding IsIdle}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Target margin (mm):" VerticalAlignment="Center" Margin="4"/>
                                    <TextBox Grid.Row="1" Grid.Column="1"
                                             Text="{Binding Parameters.TargetInternalMarginMm, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                             IsEnabled="{Binding IsIdle}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="OAR Avoidance 1:" VerticalAlignment="Center" Margin="4"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1"
                                              ItemsSource="{Binding AvailableOARs}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding Parameters.AvoidanceOar1Id}"
                                              IsEnabled="{Binding IsIdle}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="OAR 1 clearance (mm):" VerticalAlignment="Center" Margin="4"/>
                                    <TextBox Grid.Row="3" Grid.Column="1"
                                             Text="{Binding Parameters.AvoidanceOar1ClearanceMm, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                             IsEnabled="{Binding IsIdle}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="OAR Avoidance 2:" VerticalAlignment="Center" Margin="4"/>
                                    <ComboBox Grid.Row="4" Grid.Column="1"
                                              ItemsSource="{Binding AvailableOARs}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding Parameters.AvoidanceOar2Id}"
                                              IsEnabled="{Binding IsIdle}"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="OAR 2 clearance (mm):" VerticalAlignment="Center" Margin="4"/>
                                    <TextBox Grid.Row="5" Grid.Column="1"
                                             Text="{Binding Parameters.AvoidanceOar2ClearanceMm, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                             IsEnabled="{Binding IsIdle}"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Skin / EXTERNAL (mm):" VerticalAlignment="Center" Margin="4"/>
                                    <TextBox Grid.Row="6" Grid.Column="1"
                                             Text="{Binding Parameters.ExternalBoundaryClearanceMm, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                             IsEnabled="{Binding IsIdle}"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Sphere diameter, spacing, topology" Margin="0,0,0,8">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="176"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Sphere diameter (mm):" VerticalAlignment="Center" Margin="4"/>
                                    <TextBox Grid.Row="0" Grid.Column="1"
                                             Text="{Binding Parameters.SphereDiameterMm, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                             IsEnabled="{Binding IsIdle}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Spacing mode:" VerticalAlignment="Center" Margin="4"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="4">
                                        <RadioButton Content="Universal"
                                                     GroupName="SpacingMode"
                                                     IsChecked="{Binding SelectedUniversalSpacing}"
                                                     IsEnabled="{Binding IsIdle}"
                                                     Margin="0,0,16,0"/>
                                        <RadioButton Content="Directional"
                                                     GroupName="SpacingMode"
                                                     IsChecked="{Binding SelectedDirectionalSpacing}"
                                                     IsEnabled="{Binding IsIdle}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Universal pitch (mm):" VerticalAlignment="Center" Margin="4"/>
                                    <TextBox Grid.Row="2" Grid.Column="1"
                                             Text="{Binding Parameters.CenterSpacingMm, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                             IsEnabled="{Binding Parameters.IsUniversalSpacing}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Lateral dxy (mm):" VerticalAlignment="Center" Margin="4"/>
                                    <TextBox Grid.Row="3" Grid.Column="1"
                                             Text="{Binding Parameters.LateralSpacingMm, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                             IsEnabled="{Binding Parameters.IsDirectionalSpacing}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="SI spacing dz (mm):" VerticalAlignment="Center" Margin="4"/>
                                    <TextBox Grid.Row="4" Grid.Column="1"
                                             Text="{Binding Parameters.SiSpacingMm, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                             IsEnabled="{Binding Parameters.IsDirectionalSpacing}"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Topology:" VerticalAlignment="Center" Margin="4"/>
                                    <ComboBox Grid.Row="5" Grid.Column="1"
                                              ItemsSource="{Binding PackingOptions}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding Parameters.PackingMode}"
                                              IsEnabled="{Binding IsIdle}"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Grid rotation (°):" VerticalAlignment="Center" Margin="4"/>
                                    <DockPanel Grid.Row="6" Grid.Column="1" Margin="4">
                                        <TextBlock DockPanel.Dock="Right" Width="40" Text="{Binding Parameters.GridRotationDeg, StringFormat=F0}"
                                                   VerticalAlignment="Center"/>
                                        <Slider Minimum="0" Maximum="90" TickFrequency="5" IsSnapToTickEnabled="False"
                                                Value="{Binding Parameters.GridRotationDeg, UpdateSourceTrigger=PropertyChanged}"
                                                IsEnabled="{Binding IsIdle}"/>
                                    </DockPanel>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Sphere structures:" VerticalAlignment="Center" Margin="4"/>
                                    <ComboBox Grid.Row="7" Grid.Column="1"
                                              ItemsSource="{Binding GenerationModeOptions}"
                                              DisplayMemberPath="Display"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding Parameters.GenerationMode}"
                                              IsEnabled="{Binding IsIdle}"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Max sphere count:" VerticalAlignment="Center" Margin="4"/>
                                    <TextBox Grid.Row="8" Grid.Column="1"
                                             Text="{Binding Parameters.MaxSphereCount, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                             IsEnabled="{Binding IsIdle}"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Sphere maximization" Margin="0,0,0,8">
                                <StackPanel Margin="4">
                                    <CheckBox Content="Maximize Sphere Count (Auto-Shift Grid)"
                                              IsChecked="{Binding Parameters.EnableSphereMaximization}"
                                              IsEnabled="{Binding IsIdle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="176"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Strategy:" VerticalAlignment="Center" Margin="4"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1"
                                                  ItemsSource="{Binding MaximizationStrategyOptions}"
                                                  DisplayMemberPath="Display"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding Parameters.OptimizationStrategy}"
                                                  IsEnabled="{Binding Parameters.EnableSphereMaximization}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Max iterations:" VerticalAlignment="Center" Margin="4"/>
                                        <DockPanel Grid.Row="1" Grid.Column="1" Margin="4">
                                            <TextBox DockPanel.Dock="Right" Width="52"
                                                     Text="{Binding Parameters.MaxIterations, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                                     IsEnabled="{Binding Parameters.EnableSphereMaximization}"/>
                                            <Slider Minimum="10" Maximum="1000" TickFrequency="10"
                                                    Value="{Binding Parameters.MaxIterations, UpdateSourceTrigger=PropertyChanged}"
                                                    IsEnabled="{Binding Parameters.EnableSphereMaximization}"/>
                                        </DockPanel>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Voxel SDF:" VerticalAlignment="Center" Margin="4"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="2.0 mm isotropic (fixed)"
                                                   VerticalAlignment="Center" Margin="4" Foreground="#445"/>
                                    </Grid>
                                    <TextBlock Text="{Binding MaximizationStatusText}" TextWrapping="Wrap"
                                               Margin="4,6,4,2" FontFamily="Consolas" FontSize="12"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Geometry &amp; Tuning" Margin="0,0,0,8">
                                <StackPanel Margin="4">
                                    <CheckBox Content="Generate Tuning Structures (Penumbra Shell, Valley Core, Rings)"
                                              IsChecked="{Binding Parameters.GenerateTuningStructures}"
                                              IsEnabled="{Binding IsIdle}"
                                              ToolTip="Peak_Penumbra shell, Valley_Core, and External-clipped concentric rings for steep PO gradients."/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="176"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Penumbra shell (mm):" VerticalAlignment="Center" Margin="4"/>
                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                 Text="{Binding Parameters.PenumbraShellThicknessMm, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                                 IsEnabled="{Binding Parameters.GenerateTuningStructures}"
                                                 ToolTip="d_shell = d_margin (1.0–5.0 mm). Default 3.0 mm."/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ring 1 outer (mm):" VerticalAlignment="Center" Margin="4"/>
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 Text="{Binding Parameters.ConcentricRing1Mm, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                                 IsEnabled="{Binding Parameters.GenerateTuningStructures}"
                                                 ToolTip="Ring_SFRT_0-1cm outer expansion. Default 10 mm."/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ring 2 outer (mm):" VerticalAlignment="Center" Margin="4"/>
                                        <TextBox Grid.Row="2" Grid.Column="1"
                                                 Text="{Binding Parameters.ConcentricRing2Mm, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                                 IsEnabled="{Binding Parameters.GenerateTuningStructures}"
                                                 ToolTip="Ring_SFRT_1-3cm outer expansion. Default 30 mm."/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Pre-calculation summary" Margin="0,0,0,8">
                                <TextBox Text="{Binding FeasibilityText, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         MinHeight="140"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Margin="4"/>
                            </GroupBox>

                            <WrapPanel>
                                <Button Content="Preview Lattice"
                                        Command="{Binding PreviewLatticeCommand}"
                                        IsEnabled="{Binding CanPreview}"/>
                                <Button Content="Generate Spheres &amp; Rings"
                                        Command="{Binding GenerateStructuresCommand}"
                                        IsEnabled="{Binding CanGenerateSpheresAndRings}"
                                        FontWeight="SemiBold"/>
                                <Button Content="Regenerate Remaining"
                                        Command="{Binding RegenerateRemainingCommand}"
                                        IsEnabled="{Binding CanRegenerateRemaining}"/>
                                <Button Content="Cancel"
                                        Command="{Binding CancelCommand}"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                            </WrapPanel>
                            <ProgressBar Height="14" Margin="4,4,4,8" Minimum="0" Maximum="100"
                                         Value="{Binding WorkProgress, Mode=OneWay}"/>

                            <GroupBox Header="Candidate peaks (uncheck Include to exclude before commit)" Margin="0,0,0,0" Height="200">
                                <DataGrid ItemsSource="{Binding GeneratedSpheres}" IsReadOnly="False">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Include" Binding="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}" Width="64"/>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="X" Binding="{Binding X, StringFormat=F1}" Width="60" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Y" Binding="{Binding Y, StringFormat=F1}" Width="60" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Z" Binding="{Binding Z, StringFormat=F1}" Width="60" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="R" Binding="{Binding Radius, StringFormat=F1}" Width="50" IsReadOnly="True"/>
                                        <DataGridCheckBoxColumn Header="Edited" Binding="{Binding IsEdited}" Width="60" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Slice −" Width="80" Command="{Binding SliceDownCommand}"/>
                            <TextBlock Text="{Binding CurrentSliceText}" VerticalAlignment="Center"
                                       FontWeight="Bold" Margin="10,0"/>
                            <Button Content="Slice +" Width="80" Command="{Binding SliceUpCommand}"/>
                            <TextBlock Text="Drag a peak on the axial view. Invalid moves (outside V_valid or too close) are blocked."
                                       Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                        <GroupBox Grid.Row="1" Header="Axial 2D viewer">
                            <Grid Background="#111">
                                <Canvas Name="AxialCanvas" Background="Black"/>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 2: Automation -->
            <TabItem Header="Plan Automation">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="Photon Optimizer and VMAT helpers"
                                   FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="These routines run on the Eclipse STA thread. Seed PO after Lattice_Peaks and Valley_Core (or Lattice_Valley) exist. VMAT setup copies machine parameters from an existing treatment beam and adds two coplanar arcs (collimators 15° and 75°) with jaw tracking."/>

                        <GroupBox Header="Plan Automation &amp; PO Seeding" Margin="0,0,0,12">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Linac / energy:" VerticalAlignment="Center" Margin="4"/>
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          ItemsSource="{Binding LinacEnergyOptions}"
                                          DisplayMemberPath="Display"
                                          SelectedItem="{Binding SelectedLinacOption}"
                                          IsEnabled="{Binding IsIdle}"
                                          ToolTip="Commissioned photon beams inherited from plans on this patient. Used when the active plan has no treatment beam."/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Prescription D_rx (Gy):" VerticalAlignment="Center" Margin="4"/>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding Parameters.PrescriptionDoseGy, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                         IsEnabled="{Binding IsIdle}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Fractions (N_fx):" VerticalAlignment="Center" Margin="4"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding Parameters.Fractions, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                         IsEnabled="{Binding IsIdle}"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Objective preset:" VerticalAlignment="Center" Margin="4"/>
                                <ComboBox Grid.Row="3" Grid.Column="1"
                                          ItemsSource="{Binding PoObjectivePresetOptions}"
                                          DisplayMemberPath="Display"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedPoObjectivePreset}"
                                          IsEnabled="{Binding IsIdle}"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="OAR 1 Dmax (Gy):" VerticalAlignment="Center" Margin="4"/>
                                <TextBox Grid.Row="4" Grid.Column="1"
                                         Text="{Binding Parameters.Oar1DoseLimitGy, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                         IsEnabled="{Binding IsIdle}"
                                         ToolTip="Upper Dmax for OAR Avoidance 1 when selected (e.g. cord 10–14 Gy in 1 fx)."/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="OAR 2 Dmax (Gy):" VerticalAlignment="Center" Margin="4"/>
                                <TextBox Grid.Row="5" Grid.Column="1"
                                         Text="{Binding Parameters.Oar2DoseLimitGy, UpdateSourceTrigger=LostFocus, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                         IsEnabled="{Binding IsIdle}"/>

                                <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                                          Content="Auto-enable Jaw Tracking"
                                          IsChecked="{Binding Parameters.AutoEnableJawTracking}"
                                          IsEnabled="{Binding IsIdle}"/>

                                <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Margin="4,8,4,4">
                                    <RadioButton Content="Clear Existing Objectives"
                                                 GroupName="PoSeedMode"
                                                 IsChecked="{Binding Parameters.ClearExistingObjectives}"
                                                 IsEnabled="{Binding IsIdle}"
                                                 Margin="0,0,0,4"/>
                                    <RadioButton Content="Append to Existing"
                                                 GroupName="PoSeedMode"
                                                 IsChecked="{Binding Parameters.AppendObjectives}"
                                                 IsEnabled="{Binding IsIdle}"/>
                                </StackPanel>

                                <WrapPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                    <Button Content="Setup 2-Arc VMAT Template"
                                            Command="{Binding SetupVmatArcsCommand}"
                                            IsEnabled="{Binding CanAutomate}"/>
                                    <Button Content="Seed PO Objectives"
                                            Command="{Binding SeedPoObjectivesCommand}"
                                            IsEnabled="{Binding CanSeedPoObjectives}"
                                            FontWeight="SemiBold"/>
                                </WrapPanel>
                                <TextBlock Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"
                                           TextWrapping="Wrap" Margin="4,8,4,0" Foreground="#445"
                                           Text="VMAT: two coplanar arcs, collimators 15° / 75°, technique ARC, default MLC. Machine/energy inherited from an existing treatment beam or the linac dropdown. Peaks: Lower 100% Rx at V99 (priority 120). Valley_Core: Upper 30–40% Rx."/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="QA report" Margin="0,0,0,12">
                            <StackPanel Margin="8">
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="Exports a CSV metric table plus a companion PDF summary (PVDR, gEUD, volume fraction, dose-grid / MU guards, and alerts). Evaluate a calculated plan first."/>
                                <Button Content="Export QA Report"
                                        HorizontalAlignment="Left"
                                        Command="{Binding ExportQaReportCommand}"
                                        IsEnabled="{Binding CanExportQa}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Structure naming (TG-263 / 16-character Eclipse IDs)">
                            <TextBlock Margin="8" FontFamily="Consolas" TextWrapping="Wrap"
                                       Text="Peak_01 … Peak_nn&#x0a;Lattice_Peaks = ∪ Peak_i&#x0a;Lattice_Valley = Target \ Lattice_Peaks&#x0a;Peak_Penumbra = (Peaks + d_shell) \ Peaks ∩ Target&#x0a;Valley_Core = Target \ (Peaks + d_shell)&#x0a;Ring_SFRT_0-1cm = ((Target + r1) \ Target) ∩ External&#x0a;Ring_SFRT_1-3cm = ((Target + r2) \ (Target + r1)) ∩ External&#x0a;POI_Peak_Center / POI_Valley_Center"/>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- Tab 3: Evaluation -->
            <TabItem Header="Plan Evaluation &amp; QA">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="160"/>
                        <RowDefinition Height="140"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Plan / PlanSum:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailablePlans}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedPlan}"
                                  IsEnabled="{Binding IsIdle}"/>
                        <Button Grid.Column="2" Content="Refresh Plans"
                                Command="{Binding RefreshPlansCommand}"/>
                        <Button Grid.Column="3" Content="Evaluate Plan"
                                Command="{Binding EvaluatePlanCommand}"
                                IsEnabled="{Binding CanEvaluate}"/>
                        <Button Grid.Column="4" Content="Export QA Report"
                                Command="{Binding ExportQaReportCommand}"
                                IsEnabled="{Binding CanExportQa}"/>
                    </Grid>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                        <Border Style="{StaticResource Badge}">
                            <TextBlock Text="{Binding DoseGridBadge}"/>
                        </Border>
                        <Border Style="{StaticResource Badge}">
                            <TextBlock Text="{Binding VolumeFractionBadge}"/>
                        </Border>
                        <Border Style="{StaticResource Badge}">
                            <TextBlock Text="{Binding OvermodulationBadge}"/>
                        </Border>
                    </WrapPanel>

                    <Border Grid.Row="2" Margin="0,0,0,8" Padding="8" CornerRadius="3"
                            BorderThickness="1"
                            Background="#FFF8E7" BorderBrush="#C9A227">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="QA:" FontWeight="Bold" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding EvaluationAlertText}" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <GroupBox Grid.Row="3" Header="Peak vs valley dosimetry, PVDR, gEUD" Margin="0,0,0,8">
                        <DataGrid ItemsSource="{Binding EvaluationMetrics}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90"/>
                                <DataGridTextColumn Header="Structure" Binding="{Binding Structure}" Width="160"/>
                                <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="130"/>
                                <DataGridTextColumn Header="Absolute" Binding="{Binding Absolute}" Width="110"/>
                                <DataGridTextColumn Header="Relative / flag" Binding="{Binding Relative}" Width="130"/>
                                <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Grid.Row="4" Header="Inter-peak dose uniformity" Margin="0,0,0,8">
                        <DataGrid ItemsSource="{Binding IndividualPeakDoses}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="100"/>
                                <DataGridTextColumn Header="Volume (cc)" Binding="{Binding VolumeCc, StringFormat=F2}" Width="110"/>
                                <DataGridTextColumn Header="Dmax (Gy)" Binding="{Binding DmaxGy, StringFormat=F2}" Width="110"/>
                                <DataGridTextColumn Header="Dmean (Gy)" Binding="{Binding DmeanGy, StringFormat=F2}" Width="110"/>
                                <DataGridTextColumn Header="Dmin (Gy)" Binding="{Binding DminGy, StringFormat=F2}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Grid.Row="5" Header="Peak-to-valley spatial gradients">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding MeanGradientText}" Margin="4" FontWeight="SemiBold"/>
                            <DataGrid ItemsSource="{Binding GradientRows}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Peak A" Binding="{Binding PeakA}" Width="90"/>
                                    <DataGridTextColumn Header="Peak B" Binding="{Binding PeakB}" Width="90"/>
                                    <DataGridTextColumn Header="Sep (mm)" Binding="{Binding SeparationMm, StringFormat=F1}" Width="90"/>
                                    <DataGridTextColumn Header="Trough (Gy)" Binding="{Binding TroughGy, StringFormat=F2}" Width="100"/>
                                    <DataGridTextColumn Header="Peak (Gy)" Binding="{Binding PeakGy, StringFormat=F2}" Width="90"/>
                                    <DataGridTextColumn Header="Gradient (Gy/mm)" Binding="{Binding GradientGyPerMm, StringFormat=F2}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

        </TabControl>

        <ProgressBar Grid.Row="2" Height="8" Margin="0,6,0,4" Minimum="0" Maximum="100"
                     Value="{Binding WorkProgress, Mode=OneWay}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
